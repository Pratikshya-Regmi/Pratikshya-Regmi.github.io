---
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import JourneyMap from '../components/JourneyMap.astro';
import research from '../data/research.json';
---
<Base title="Geospatial scientist & Ph.D. candidate">
<section class="hero"><div class="hero-copy"><span class="eyebrow"><span class="status-dot"></span> Geospatial scientist / NCSU</span><h1>Pratikshya<br/><em>Regmi.</em></h1><p class="hero-name">{research.tagline}</p><div class="actions"><a class="button secondary" href="/assets/Pratikshya_Resume_Oct_2026.pdf" target="_blank" rel="noopener noreferrer">View Resume</a><a class="button secondary" href="/assets/CV_PR.pdf" target="_blank" rel="noopener noreferrer">View CV</a></div><p class="hero-affiliation">Fourth-year Ph.D. candidate, Center for Geospatial Analytics.<br/>Research on reproducible fusion of LiDAR, UAS, and satellite imagery to study post-disaster landscape change and forest disturbance.</p></div><div class="hero-visual"><Figure src="/assets/img/IMG_5958 (1)copy.jpeg" alt="Portrait of Pratikshya Regmi" caption="Pratikshya Regmi · Geospatial scientist and researcher." eager/></div></section>
<section class="section communication-preview"><div class="section-heading"><div><span class="eyebrow">Research with reach</span><h2>From complex data<br/>to shared understanding.</h2></div><div class="communication-copy"><p class="communication-lead">I turn complex environmental data into reproducible analysis, practical geospatial tools, and clear scientific insight.</p><p>My research focuses on how extreme events, especially hurricanes, reshape landscapes and forests. I use LiDAR, drone imagery, and geospatial modeling to measure changes in terrain, water flow, and forest structure, helping us better understand recovery and future hazards.</p><p>I bring this work to broader audiences through conference presentations, workshops, open-source contributions, and collaboration. The goal is to make technical research clear, useful, and accessible to the people and communities who can apply it.</p></div></div><div class="actions communication-actions"><a class="text-link" href="/presentations/" target="_blank" rel="noopener noreferrer">Presentations ↗</a><a class="text-link" href="/workshops/" target="_blank" rel="noopener noreferrer">Workshops ↗</a><a class="text-link" href="/community/" target="_blank" rel="noopener noreferrer">Community &amp; outreach ↗</a></div></section>
<JourneyMap/>
</Base>
