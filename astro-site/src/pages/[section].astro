---
import {getCollection,type CollectionKey} from 'astro:content';
import {newestFirst} from '../utils/chronology';
import Base from '../layouts/Base.astro';
import Records from '../components/Records.astro';
import ProjectList from '../components/ProjectList.astro';
import research from '../data/research.json';
export function getStaticPaths(){return [
 ['education','Education','A geospatial journey across Nepal and the United States.','education'],
 ['experience','Professional Experience','Research, teaching, fieldwork, and geospatial development.','experience'],
 ['projects','Projects',research.projectsIntro,'projects'],
 ['presentations','Presentations','Conference talks, posters, symposium contributions, and webinars.','presentations'],
 ['workshops','Workshops Delivered','Workshops I delivered on open-source GIS, environmental modeling, and Tangible Landscape.','workshops'],
 ['honors','Honors & Awards','Recognition, scholarships, and research support.','honors'],
 ['Publications','Publications','Journal articles, proceedings, thesis research, and conference abstracts.','publications']
].map(([section,title,description,collection])=>({params:{section},props:{title,description,collection}}));}
const {section}=Astro.params;
const {title,description,collection}=Astro.props;
const entries=(await getCollection(collection as CollectionKey)).sort(newestFirst);
const hackathons=section==='projects'?(await getCollection('engagement')).filter(e=>e.id==='hackathon'):[];
---
<Base title={title} description={description}><header class="page-head"><span class="eyebrow">Pratikshya Regmi / {title}</span><h1>{title}</h1><p>{description}</p></header><div class="page-body">
{section==='projects' ? <><ProjectList heading="h2" filters/><section id="hackathons" class="subsection"><h2>Hackathons</h2><Records entries={hackathons} hideTitle/></section></> : section==='presentations' ? <><span id="conferences" aria-hidden="true"></span><span id="symposiums" aria-hidden="true"></span><span id="webinars" aria-hidden="true"></span><Records entries={entries}/></> : <Records entries={entries} compact={section==='honors' || section==='Publications'}/>}
{section==='workshops' && <div class="link-grid"><a href="https://github.com/ncsu-geoforall-lab/csdms-grass-2025">2025 workshop repository ↗</a><a href="https://github.com/ncsu-geoforall-lab/csdms-grass-2024">2024 workshop repository ↗</a></div>}
{section==='honors' && <a class="text-link" href="https://www.linkedin.com/in/pratiregmi/details/honors/">Honors on LinkedIn ↗</a>}
</div></Base>
