---
import Base from '../layouts/Base.astro';
---

<Base title="CV & Resume" description="View or download Pratikshya Regmi's academic CV and Resume.">
  <section class="page-body">
    <div class="work-index">
      <article class="subsection">
        <span class="eyebrow">Employment document</span>
        <h2>Resume</h2>
        <p>
          A concise summary of research, geospatial methods, science
          communication, technical skills, honors, and leadership.
        </p>
        <div class="actions">
          <a
            class="button"
            href="/assets/Pratikshya_Resume_Oct_2026.pdf"
            target="_blank"
            rel="noopener noreferrer"
          >
            View Resume <span aria-hidden="true">↗</span>
          </a>
          <a
            class="button secondary"
            href="/assets/Pratikshya_Resume_Oct_2026.pdf"
            download="Pratikshya-Regmi-Resume.pdf"
          >
            Download Resume
          </a>
        </div>
      </article>

      <article class="subsection">
        <span class="eyebrow">Academic document</span>
        <h2>Curriculum vitae</h2>
        <p>
          A detailed record of education, research experience, publications,
          presentations, workshops, honors, service, and certifications.
        </p>
        <div class="actions">
          <a
            class="button"
            href="/assets/CV_PR.pdf"
            target="_blank"
            rel="noopener noreferrer"
          >
            View CV <span aria-hidden="true">↗</span>
          </a>
          <a class="button secondary" href="/assets/CV_PR.pdf" download="Pratikshya-Regmi-CV.pdf">
            Download CV
          </a>
        </div>
      </article>
    </div>
  </section>
</Base>
