---
import Base from '../layouts/Base.astro';
import profile from '../data/profile.json';
---
<Base title="Contact"><header class="page-head"><span class="eyebrow">Open to conversation</span><h1>Let's make<br/>new connections.</h1><p>For research collaboration, geospatial conversations, workshops, or opportunities to work together, please get in touch.</p></header><section class="page-body"><div class="link-grid"><a href={`mailto:${profile.email}`}>Email<br/>{profile.email} ↗</a><a href={profile.github}>Code & open-source work<br/>GitHub ↗</a><a href={profile.linkedin}>Professional updates<br/>LinkedIn ↗</a><a href="/cv/" target="_blank" rel="noopener noreferrer">Background & experience<br/>CV & résumé ↗</a></div><p class="location">Center for Geospatial Analytics · North Carolina State University<br/>Raleigh, North Carolina</p></section></Base>
