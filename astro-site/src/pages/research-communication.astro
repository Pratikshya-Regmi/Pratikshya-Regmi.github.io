---
import {getCollection} from 'astro:content';
import Base from '../layouts/Base.astro';
import Records from '../components/Records.astro';
import {newestFirst} from '../utils/chronology';
const presentations=(await getCollection('presentations')).sort(newestFirst);
const workshops=(await getCollection('workshops')).sort(newestFirst);
const publications=(await getCollection('publications')).sort(newestFirst);
---
<Base title="Research Communication" description="Presentations, workshops, and publications that communicate Pratikshya Regmi's geospatial research.">
<header class="page-head"><span class="eyebrow">Research Communication</span><h1>Research made available to others.</h1><p>I share geospatial research through conference presentations, delivered workshops, publications, and clear, reproducible materials.</p><nav class="section-links" aria-label="Research communication sections"><a href="#presentations">Presentations</a><a href="#workshops">Workshops Delivered</a><a href="#publications">Publications</a></nav></header>
<div class="page-body"><section id="presentations"><h2>Presentations</h2><p>Conference and symposium presentations, posters, and invited research communication.</p><Records entries={presentations} heading="h3"/></section><section id="workshops" class="subsection"><h2>Workshops Delivered</h2><p>Hands-on workshops that make geospatial methods and open-source tools accessible to participants.</p><Records entries={workshops} heading="h3"/></section><section id="publications" class="subsection"><h2>Publications</h2><Records entries={publications} heading="h3" compact/></section></div>
</Base>
