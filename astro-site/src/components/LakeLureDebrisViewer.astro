<section class="debris-viewer" aria-labelledby="debris-viewer-title">
  <div class="debris-viewer-heading">
    <span class="eyebrow">Figure · CAP aerial imagery</span>
    <h2 id="debris-viewer-title">Photogrammetric point cloud of debris accumulation in Lake Lure after Hurricane Helene, captured from CAP aerial imagery.</h2>
  </div>
  <div class="debris-stage">
    <canvas data-debris-canvas aria-label="Interactive three-dimensional photogrammetric point cloud of debris accumulation in Lake Lure"></canvas>
    <p class="debris-loading" data-debris-status role="status">Loading optimized point cloud…</p>
  </div>
  <p class="debris-controls">Drag to orbit · Scroll to zoom · Double-click to reset</p>
</section>
<script>
  const root = document.querySelector('[data-debris-canvas]')?.closest('.debris-viewer');
  if (root) {
    const canvas = root.querySelector('[data-debris-canvas]');
    const status = root.querySelector('[data-debris-status]');
    const gl = canvas.getContext('webgl', { antialias: true, alpha: false });
    let points, program, buffer, positionLocation, colorLocation, pointSizeLocation;
    let yaw = 0.55, pitch = 0.22, distance = 2.2, dragging = false, lastX = 0, lastY = 0;
    const vertexSource = `attribute vec3 aPosition; attribute vec3 aColor; uniform mat4 uMatrix; uniform float uPointSize; varying vec3 vColor; void main(){gl_Position=uMatrix*vec4(aPosition,1.0); gl_PointSize=uPointSize; vColor=aColor;}`;
    const fragmentSource = `precision mediump float; varying vec3 vColor; void main(){vec2 p=gl_PointCoord-0.5; if(dot(p,p)>0.25) discard; gl_FragColor=vec4(vColor,0.88);}`;
    const compile = (type, source) => { const shader = gl.createShader(type); gl.shaderSource(shader, source); gl.compileShader(shader); if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(shader)); return shader; };
    const resize = () => { const ratio = Math.min(window.devicePixelRatio || 1, 2); const box = canvas.getBoundingClientRect(); canvas.width = box.width * ratio; canvas.height = box.height * ratio; gl.viewport(0, 0, canvas.width, canvas.height); draw(); };
    const matrix = () => {
      const aspect = canvas.width / Math.max(1, canvas.height), fov = 1.05, near = 0.1, far = 100;
      const f = 1 / Math.tan(fov / 2), projection = [f / aspect, 0, 0, 0, 0, f, 0, 0, 0, 0, (far + near) / (near - far), -1, 0, 0, 2 * far * near / (near - far), 0];
      const cy = Math.cos(yaw), sy = Math.sin(yaw), cp = Math.cos(pitch), sp = Math.sin(pitch);
      const view = [cy, sy * sp, sy * cp, 0, 0, cp, -sp, 0, -sy, cy * sp, cy * cp, 0, 0, 0, -distance, 1];
      const out = new Array(16).fill(0);
      for (let row = 0; row < 4; row++) for (let col = 0; col < 4; col++) for (let k = 0; k < 4; k++) out[col * 4 + row] += projection[k * 4 + row] * view[col * 4 + k];
      return out;
    };
    const draw = () => {
      if (!points || !program) return;
      gl.clearColor(0.025, 0.055, 0.08, 1); gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT); gl.enable(gl.BLEND); gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);
      gl.useProgram(program); gl.bindBuffer(gl.ARRAY_BUFFER, buffer); gl.enableVertexAttribArray(positionLocation); gl.enableVertexAttribArray(colorLocation); gl.vertexAttribPointer(positionLocation, 3, gl.FLOAT, false, 24, 0); gl.vertexAttribPointer(colorLocation, 3, gl.FLOAT, false, 24, 12);
      gl.uniformMatrix4fv(gl.getUniformLocation(program, 'uMatrix'), false, matrix()); gl.uniform1f(pointSizeLocation, Math.max(1.5, Math.min(5, canvas.width / 260)));
      gl.drawArrays(gl.POINTS, 0, points.length); requestAnimationFrame(draw);
    };
    const setup = (json) => {
      points = json.points.map(point => new Float32Array([point[0], point[1], point[2], point[4], point[5], point[6]]));
      const flat = new Float32Array(points.length * 6); points.forEach((point, index) => flat.set(point, index * 6));
      program = gl.createProgram(); gl.attachShader(program, compile(gl.VERTEX_SHADER, vertexSource)); gl.attachShader(program, compile(gl.FRAGMENT_SHADER, fragmentSource)); gl.linkProgram(program); if (!gl.getProgramParameter(program, gl.LINK_STATUS)) throw new Error('Point-cloud shader could not be linked');
      buffer = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, buffer); gl.bufferData(gl.ARRAY_BUFFER, flat, gl.STATIC_DRAW); positionLocation = gl.getAttribLocation(program, 'aPosition'); colorLocation = gl.getAttribLocation(program, 'aColor'); pointSizeLocation = gl.getUniformLocation(program, 'uPointSize'); status.hidden = true; resize();
    };
    fetch('/data/lake-lure-debris.json').then(response => { if (!response.ok) throw new Error('CAP point cloud could not be loaded'); return response.json(); }).then(setup).catch(error => { status.textContent = 'The optimized CAP point cloud is temporarily unavailable.'; console.error(error); });
    canvas.addEventListener('pointerdown', event => { dragging = true; lastX = event.clientX; lastY = event.clientY; canvas.setPointerCapture(event.pointerId); });
    canvas.addEventListener('pointermove', event => { if (!dragging) return; yaw += (event.clientX - lastX) * 0.008; pitch = Math.max(-1.2, Math.min(1.2, pitch + (event.clientY - lastY) * 0.008)); lastX = event.clientX; lastY = event.clientY; });
    canvas.addEventListener('pointerup', () => { dragging = false; });
    canvas.addEventListener('wheel', event => { event.preventDefault(); distance = Math.max(2.2, Math.min(10, distance + event.deltaY * 0.002)); }, { passive: false });
    canvas.addEventListener('dblclick', () => { yaw = 0.55; pitch = 0.22; distance = 2.2; });
    window.addEventListener('resize', resize);
  }
</script>
