---
import { render } from 'astro:content';
import Figure from './Figure.astro';
const {entries, showImages=true, heading='h2', hideTitle=false, compact=false} = Astro.props;
const Heading=heading;
const records=await Promise.all(entries.map(async(entry:any)=>({...entry, rendered:await render(entry)})));
---
<div class:list={["records",{compact}]}>{records.map((entry:any)=>{const {Content}=entry.rendered; return <article class:list={['record',{'with-image':showImages && entry.data.image}]} id={hideTitle ? `record-${entry.id}` : entry.id}><div><div class="eyebrow">{entry.data.date} {entry.data.kind && ` / ${entry.data.kind}`}</div>{!hideTitle && <Heading>{entry.data.title}</Heading>}{(!entry.body?.trim() && entry.data.summary!=="Publication, thesis, or conference contribution") && <p class="record-summary">{entry.data.summary}</p>}{entry.data.location && <p class="location">{entry.data.location}</p>}<div class="prose"><Content/></div>{entry.data.links.map((link:any)=><a class="text-link" href={link.url}>{link.label} ↗</a>)}{entry.data.related.map((link:any)=><a class="text-link related-link" href={link.url}>{link.label} ↗</a>)}{entry.data.pending.map((text:string)=><p class="pending-note">{text}</p>)}</div>{showImages && entry.data.image && <Figure src={entry.data.image} alt={entry.data.alt ?? entry.data.title}/>}</article>})}</div>
