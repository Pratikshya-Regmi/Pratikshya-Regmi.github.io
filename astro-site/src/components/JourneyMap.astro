---
import {getEntry} from 'astro:content';
import locations from '../data/locations.json';
import journey from '../data/journey.json';
import {distanceLabel} from '../utils/journey-geometry';
const nepal=locations.find(p=>p.id==='kathmandu')!;
const texas=locations.find(p=>p.id==='tamucc')!;
const distance=distanceLabel([nepal.lng,nepal.lat],[texas.lng,texas.lat]);
interface Photo {src:string;alt:string;caption:string;width:number;height:number}
const chapters=await Promise.all(journey.chapters.map(async chapter=>{
  const place=locations.find(location=>location.id===chapter.locationId)!;
  const record=chapter.record ? await getEntry(chapter.record.collection as 'education'|'experience',chapter.record.id) : undefined;
  return {...chapter,...place,date:record?.data.date ?? '',photos:chapter.photos as Photo[]};
}));
---
<section class="journey" id="journey" data-journey data-chapters={JSON.stringify(chapters)} aria-labelledby="journey-title">
  <header class="journey-heading"><div><span class="eyebrow">A life in places</span><h2 id="journey-title">From Nepal<br/>to North Carolina.</h2></div><p>A village, classrooms, coastlines, and a new research home. Explore the places along my journey.</p></header>
  <div class="journey-layout" data-journey-layout>
    <div class="journey-geography">
      <div class="journey-map" data-journey-canvas hidden aria-label="Satellite and terrain map of my journey"></div>
      <div class="journey-tour-caption" data-tour-caption hidden><strong data-tour-heading></strong><p data-tour-detail></p></div>
      <div class="journey-cover" data-journey-cover>
        <span class="eyebrow">Nepal → United States</span>
        <svg viewBox="0 0 640 260" role="img" aria-labelledby="journey-schematic-title"><title id="journey-schematic-title">Schematic journey from my home region and schools in Nepal to Texas and North Carolina; not a geographic map.</title><path d="M55 192 C110 190 95 90 180 110 S260 150 300 85 S415 40 455 132 S540 215 592 75" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="5 6"/>{[[55,192],[180,110],[245,127],[300,85],[455,132],[592,75]].map(([cx,cy],i)=><g><circle cx={cx} cy={cy} r="7" fill="currentColor"/><text x={cx} y={cy-19} fill="currentColor" text-anchor="middle" font-size="15">{i+1}</text></g>)}</svg>
        <div><p class="journey-cover-title">Different landscapes.<br/>One unfolding journey.</p><p>Earth → Nepal → United States</p><button class="button" data-journey-load hidden>Start the journey ↗</button></div>
      </div>
      <div class="journey-map-tools" data-map-tools hidden><label class="journey-place-picker">Place<select data-place-picker>{chapters.map((chapter,index)=><option value={index}>{chapter.label}</option>)}</select></label><button type="button" data-maximize aria-pressed="false">Maximize map</button><button type="button" data-overview>Earth view</button><button type="button" data-distance-view>Nepal → Texas</button><button type="button" data-restart disabled>Restart tour</button><button type="button" data-terrain aria-pressed="true">3D terrain</button><button type="button" data-labels aria-pressed="true">Place labels</button><a data-google-maps href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${chapters[0].lat},${chapters[0].lng}`)}`} target="_blank" rel="noopener noreferrer">Open in Google Maps ↗</a></div>
      <p class="journey-map-note">Kathmandu University → Texas A&amp;M–Corpus Christi: about {distance}. Great-circle distance, not an actual flight route.</p>
      <p class="journey-status" role="status" data-journey-status>Choose a chapter to read its story. Open the map to explore the terrain.</p>
    </div>
    <div class="journey-stories">
      <div class="journey-controls" data-journey-controls hidden><button type="button" data-previous aria-label="Previous journey chapter">←</button><span data-step-count>01 / 06</span><button type="button" data-next aria-label="Next journey chapter">→</button><button type="button" data-play disabled>Play journey</button></div>
      {chapters.map((chapter,index)=><article class="journey-chapter" id={`journey-${chapter.id}`} data-chapter={index} aria-labelledby={`journey-heading-${chapter.id}`}>
        <span class="eyebrow">{chapter.stage}{chapter.date && ` · ${chapter.date}`}</span>
        <h3 id={`journey-heading-${chapter.id}`}>{chapter.label}</h3>
        <p class="journey-place">{chapter.city}</p>
        {chapter.photos.map((photo, photoIndex)=> photoIndex === 0 ? <figure><img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async"/><figcaption>{photo.caption}</figcaption></figure> : <details class="journey-extra-photo"><summary>Another photo from this chapter</summary><figure><img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async"/><figcaption>{photo.caption}</figcaption></figure></details>)}
        <p>{chapter.story}</p>
        {chapter.record && <a class="text-link" href={chapter.record.href}>Explore this {chapter.branch?'research':'education'} chapter ↗</a>}
      </article>)}
    </div>
  </div>
  <nav class="journey-stops" aria-label="Journey chapters, from childhood to the present">{chapters.map((chapter,index)=><a href={`#journey-${chapter.id}`} data-stop={index}><span>{chapter.branch?'↗':String(index+1).padStart(2,'0')}</span><span><strong>{chapter.label}</strong><small>{chapter.stage}</small></span></a>)}</nav>
  <noscript><p>The complete journey is listed above. The interactive terrain map requires JavaScript.</p></noscript>
</section>
<script>
import {setupJourney} from '../scripts/journey';
document.querySelectorAll<HTMLElement>('[data-journey]').forEach(setupJourney);
</script>
<style>
.journey{margin-top:70px;--journey-accent:#b8df9a}.journey-heading{display:flex;justify-content:space-between;gap:40px;align-items:end;margin-bottom:32px}.journey-heading h2{font-size:clamp(2rem,4vw,3.5rem)}.journey-heading>p{max-width:360px;color:var(--muted)}.journey-layout{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(0,1fr);border:1px solid var(--line);background:#0b100c}.journey-geography{min-width:0;position:relative}.journey-map,.journey-cover{height:510px;width:100%;background:#050505}.journey-cover{padding:30px;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden}.journey-cover svg{width:100%;max-height:190px;color:var(--journey-accent)}.journey-cover-title{font-size:clamp(1.5rem,2.5vw,2.3rem);line-height:1.2;margin:12px 0}.journey-cover p:not(.journey-cover-title){font-size:.8rem;color:var(--muted)}.journey-cover button{margin-top:18px}.journey-map-note,.journey-status{font-size:.75rem;color:var(--muted);padding:12px 20px;margin:0}.journey-status{padding-top:0;min-height:42px}.journey-stories{padding:24px;min-width:0;border-left:1px solid var(--line)}.journey-controls{display:flex;gap:10px;align-items:center;margin-bottom:24px;font-size:.8rem}.journey-controls button,.journey-map-tools button{min-height:44px;min-width:44px;border:1px solid #435044;background:#101b14;color:#f1f3eb;padding:8px 12px;cursor:pointer}.journey-controls [data-play]{margin-left:auto}.journey-controls button:disabled{opacity:.45;cursor:default}.journey-chapter h3{font-size:clamp(1.3rem,2vw,1.85rem);line-height:1.25}.journey-chapter>p{font-size:.95rem;line-height:1.65}.journey-place{color:var(--muted)}.journey-chapter .text-link{display:inline-block;font-size:.85rem;margin-top:20px;min-height:44px}.journey-chapter figure{margin:20px 0}.journey-chapter img{width:100%;height:auto;max-height:330px;object-fit:contain;background:#050505}.journey-photo-empty{border:1px dashed #3d5140;min-height:150px;margin:20px 0;display:flex;align-items:center;gap:20px;padding:20px;color:#adc1ae}.journey-photo-empty>span{font-size:2.8rem;line-height:1;color:#6d8d71}.journey-photo-empty p{font-size:.85rem;line-height:1.6}.journey-photo-empty small{color:#b5bdb5}.journey-stops{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-left:1px solid var(--line)}.journey-stops a{display:flex;gap:14px;align-items:center;min-height:80px;padding:18px;text-decoration:none;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}.journey-stops a>span:first-child{color:var(--journey-accent);font-size:.8rem}.journey-stops strong,.journey-stops small{display:block}.journey-stops strong{font-size:.85rem;font-weight:500;line-height:1.5}.journey-stops small{color:var(--muted);font-size:.7rem}.journey-stops a[aria-current=step]{background:#18281b;box-shadow:inset 0 -2px var(--journey-accent)}.journey-stops a:hover{background:#142016}.journey-map-tools{display:flex;gap:8px;padding:12px 20px;flex-wrap:wrap}.journey-map-tools [aria-pressed=true]{border-color:var(--journey-accent)}.journey :global(.journey-marker){display:flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;border:2px solid #d7edc4;border-radius:50%;background:#112818;color:#fff;font:600 14px system-ui;box-shadow:0 2px 12px #0009;cursor:pointer}.journey :global(.journey-marker[aria-pressed=true]){background:#b8df9a;color:#0b170e;border-color:#fff}.journey :global(.maplibregl-ctrl-attrib){background:#fffffff0;color:#222}.journey :global(.maplibregl-ctrl-attrib a){color:#222}.journey :global(.maplibregl-ctrl-group button){width:44px;height:44px}.journey :global(.maplibregl-canvas:focus-visible){outline:3px solid #b8df9a;outline-offset:-3px}.journey :global(button:focus-visible),.journey a:focus-visible{outline:3px solid #b8df9a;outline-offset:3px}.journey-chapter+ .journey-chapter{margin-top:30px}
@media(max-width:850px){.journey-layout{grid-template-columns:1fr}.journey-stories{border-left:0;border-top:1px solid var(--line)}.journey-map,.journey-cover{height:380px}.journey-stops{grid-template-columns:repeat(2,minmax(0,1fr))}.journey-heading{display:block}.journey-heading>p{margin-top:20px}.journey-photo-empty{min-height:120px}.journey-chapter+ .journey-chapter{margin-top:0}}
@media(max-width:400px){.journey-stops{grid-template-columns:1fr}.journey-stories,.journey-cover{padding:18px}.journey-controls{gap:6px}.journey-controls [data-play]{font-size:.75rem}.journey-map{height:310px}}
.journey-place-picker{display:flex;gap:8px;align-items:center;width:100%;font-size:.8rem}.journey-place-picker select{min-height:44px;min-width:0;flex:1;color:#f1f3eb;background:#101b14;border:1px solid #435044;padding:8px;max-width:100%}.journey-map-tools>a{display:inline-flex;align-items:center;min-height:44px;padding:8px 10px;font-size:.8rem}.journey-map-tools button{font-size:.8rem}.journey :global(.journey-marker-name){position:absolute;top:100%;left:50%;transform:translateX(-50%);padding:4px 7px;margin-top:4px;background:#0a1710ec;color:#fff;border-radius:3px;width:max-content;max-width:170px;white-space:normal;font:12px/1.3 system-ui;pointer-events:none;text-align:center;display:none}.journey :global(.journey-marker[aria-pressed=true] .journey-marker-name),.journey :global(.journey-marker:hover .journey-marker-name),.journey :global(.journey-marker:focus-visible .journey-marker-name){display:block}.journey.journey-labels-hidden :global(.journey-marker-name){display:none}.journey :global(.journey-marker-home){border-style:dashed;background:#133422a8}
.journey-layout:fullscreen,.journey-layout:global(.maplibregl-pseudo-fullscreen){width:100%;height:100dvh;overflow:auto;margin:0;background:#0b100c;grid-template-columns:minmax(0,1fr) 340px;z-index:10000}.journey-layout:fullscreen .journey-geography,.journey-layout:global(.maplibregl-pseudo-fullscreen) .journey-geography{display:flex;flex-direction:column;height:100dvh;min-height:0}.journey-layout:fullscreen .journey-map,.journey-layout:global(.maplibregl-pseudo-fullscreen) .journey-map{flex:1;height:auto;min-height:200px}.journey-layout:fullscreen .journey-stories,.journey-layout:global(.maplibregl-pseudo-fullscreen) .journey-stories{overflow:auto;max-height:100dvh}
@media(max-width:850px){.journey-layout:fullscreen,.journey-layout:global(.maplibregl-pseudo-fullscreen){display:block}.journey-layout:fullscreen .journey-geography,.journey-layout:global(.maplibregl-pseudo-fullscreen) .journey-geography{height:100dvh}.journey-layout:fullscreen .journey-stories,.journey-layout:global(.maplibregl-pseudo-fullscreen) .journey-stories{max-height:none}}
.journey-tour-caption{position:absolute;z-index:2;top:16px;left:16px;max-width:min(440px,calc(100% - 95px));background:#08110ded;border-left:3px solid #b8df9a;padding:12px 16px;pointer-events:none}.journey-tour-caption strong{font-size:clamp(.85rem,1.4vw,1.15rem);line-height:1.4;display:block}.journey-tour-caption p{font-size:.75rem;color:#d1d9d1;line-height:1.5;margin:6px 0 0}.journey[data-tour-phase="nepal-to-usa"] .journey-tour-caption{border-color:#ffc978}.journey[data-tour-phase="nepal-to-usa"] .journey-tour-caption strong{color:#ffd393}
@media(max-width:400px){.journey-tour-caption{top:10px;left:10px;padding:9px;max-width:calc(100% - 74px)}.journey-tour-caption p{font-size:.7rem}.journey-map{height:360px}}
.journey:not(.journey-labels-hidden) :global(.journey-marker-global .journey-marker-name){display:block}
.journey-extra-photo summary{cursor:pointer;min-height:44px;padding:10px 0;color:var(--journey-accent);font-size:.85rem}.journey-extra-photo summary:focus-visible{outline:3px solid #b8df9a;outline-offset:3px}
</style>
